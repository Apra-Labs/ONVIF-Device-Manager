<UserControl x:Class="odm.ui.views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l="clr-namespace:odm.ui.controls"
             xmlns:uiloc="clr-namespace:odm.ui;assembly=odm.localization"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="root">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="Strings" MethodName="GetInstance" ObjectType="{x:Type uiloc:LocalAccount}"/>

        <!-- White dotted focus ring — visible on dark toolbar backgrounds -->
        <Style x:Key="DarkBgFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" StrokeThickness="1.5"
                                   Stroke="White" StrokeDashArray="2 1"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <VisualBrush x:Key="NameWatermarkBrush" TileMode="None" Stretch="None"
                     AlignmentX="Left" AlignmentY="Center" Viewbox="-5,7,0,0" ViewboxUnits="Absolute">
            <VisualBrush.Visual>
                <TextBlock Text="{Binding loginCaption, Source={StaticResource Strings}}" Foreground="Gray"/>
            </VisualBrush.Visual>
        </VisualBrush>
        <VisualBrush x:Key="PasswordWatermarkBrush" TileMode="None" Stretch="None"
                     AlignmentX="Left" AlignmentY="Center" Viewbox="-5,7,0,0" ViewboxUnits="Absolute">
            <VisualBrush.Visual>
                <TextBlock Text="{Binding passwordCaption, Source={StaticResource Strings}}" Foreground="Gray"/>
            </VisualBrush.Visual>
        </VisualBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Col 0: login panel (anonymous) or logged-in panel — mutually exclusive -->
        <StackPanel x:Name="panelEdit" Grid.Column="0" Orientation="Horizontal">
            <Border Background="White" BorderThickness="0" CornerRadius="2" Margin="3" VerticalAlignment="Center">
                <TextBox x:Name="username" MinWidth="100" MaxWidth="300"
                         KeyboardNavigation.TabIndex="0">
                    <TextBox.Style>
                        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource NameWatermarkBrush}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value="{x:Null}"/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource NameWatermarkBrush}"/>
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!-- TogglePasswordBox: Focusable=False on the UserControl means tab goes
                 directly to PasswordBox (tab stop 1) then the eye toggle (tab stop 2) -->
            <Border Background="White" BorderThickness="0" CornerRadius="2" Margin="3" VerticalAlignment="Center">
                <l:TogglePasswordBox x:Name="password"
                                     Height="{Binding Path=ActualHeight, ElementName=username}"
                                     MinWidth="100" MaxWidth="300"/>
            </Border>

            <Border VerticalAlignment="Center" Margin="3" Padding="0"
                    BorderThickness="1.5" CornerRadius="2"
                    KeyboardNavigation.TabIndex="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button x:Name="btLogin"
                        Content="{Binding loginButton, Source={StaticResource Strings}}"
                        FocusVisualStyle="{x:Null}"/>
            </Border>

            <Border VerticalAlignment="Center" Margin="3" Padding="2,0"
                    BorderThickness="1.5" CornerRadius="2"
                    KeyboardNavigation.TabIndex="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <CheckBox x:Name="remember" IsChecked="True"
                          FocusVisualStyle="{x:Null}">
                    <CheckBox.Content>
                        <TextBlock Text="{Binding remember, Source={StaticResource Strings}}" Foreground="WhiteSmoke"/>
                    </CheckBox.Content>
                </CheckBox>
            </Border>
        </StackPanel>

        <StackPanel x:Name="panelView" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="{Binding loggedAs, Source={StaticResource Strings}}"
                       Margin="3" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
            <TextBlock x:Name="loggedUsername" Margin="3" Foreground="WhiteSmoke"
                       FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="btLogout"
                    Content="{Binding logoutButton, Source={StaticResource Strings}}"
                    Margin="3" VerticalAlignment="Center"
                    FocusVisualStyle="{StaticResource DarkBgFocusVisual}"/>
        </StackPanel>

        <!-- Col 1: Manage Credentials — always visible, white outline on focus -->
        <Border Grid.Column="1" Margin="6,0,3,0" Padding="2,1" VerticalAlignment="Center"
                BorderThickness="1" CornerRadius="2"
                KeyboardNavigation.TabIndex="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock>
                <Hyperlink x:Name="lnkManageCredentials">
                    <Run Text="Manage Credentials" Foreground="LightGray"/>
                </Hyperlink>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
